DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/tccdb"
SECRET_KEY="troque-este-segredo"
PORT=3000

# Fuso civil global do TCC (dia/semana/mês das missões e fim da validade).
# Default se omitido: America/Sao_Paulo.
# Não há timezone por loja nesta versão.
FUSO_NEGOCIO="America/Sao_Paulo"

# --- NFC-e ---
# simulado = fixtures demo (default). sefaz = consulta oficial somente leitura.
NFCE_PROVIDER=simulado
# homologacao | producao (só quando NFCE_PROVIDER=sefaz)
SEFAZ_AMBIENTE=homologacao
# Certificado A1 do contribuinte/plataforma — NUNCA commitado no Git.
# SEFAZ_CERT_PFX_PATH=/caminho/secreto/certificado.pfx
# SEFAZ_CERT_PASSPHRASE=
# XML autorizado (procNFe) para obter vNF/dhEmi — ConsultaProtocolo NÃO retorna valor.
# NFCE_XML_DIR=/caminho/local/xmls-nfce
