generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ASSOCIACAO
  LOJISTA
  CONSUMIDOR

  @@map("UsuarioRole")
}

model Usuario {
  id        Int      @id @default(autoincrement()) @map("id_usuario")
  nome      String   @map("nome_usuario") @db.VarChar(255)
  email     String   @unique @map("email_usuario") @db.VarChar(255)
  senha     String   @map("senha_usuario") @db.VarChar(255)
  role      Role     @map("role")
  ativo     Boolean  @default(true) @map("ativo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  endereco   Endereco?
  associacao Associacao?
  lojista    Lojista?
  consumidor Consumidor?

  @@map("usuario")
}

model Endereco {
  id Int @id @default(autoincrement()) @map("id_endereco")

  cep    String  @db.VarChar(9)
  numero String? @db.VarChar(20)

  usuarioId Int     @unique @map("id_usuario")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  ruaId Int @map("id_rua")
  rua   Rua @relation(fields: [ruaId], references: [id])

  bairroId Int    @map("id_bairro")
  bairro   Bairro @relation(fields: [bairroId], references: [id])

  cidadeId Int    @map("id_cidade")
  cidade   Cidade @relation(fields: [cidadeId], references: [id])

  estadoId Int    @map("id_estado")
  estado   Estado @relation(fields: [estadoId], references: [id])

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@map("endereco")
}

model Rua {
  id   Int    @id @default(autoincrement()) @map("id_rua")
  nome String @map("nome_rua") @db.VarChar(255)

  enderecos Endereco[]

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@map("rua")
}

model Estado {
  id   Int    @id @default(autoincrement()) @map("id_estado")
  nome String @map("nome_estado") @db.VarChar(255)
  uf   String @db.VarChar(2)

  cidades   Cidade[]
  enderecos Endereco[]

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@map("estado")
}

model Cidade {
  id   Int    @id @default(autoincrement()) @map("id_cidade")
  nome String @map("nome_cidade") @db.VarChar(255)

  estadoId Int    @map("id_estado")
  estado   Estado @relation(fields: [estadoId], references: [id])

  bairros   Bairro[]
  enderecos Endereco[]

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@map("cidade")
}

model Bairro {
  id   Int    @id @default(autoincrement()) @map("id_bairro")
  nome String @map("nome_bairro") @db.VarChar(255)

  cidadeId Int    @map("id_cidade")
  cidade   Cidade @relation(fields: [cidadeId], references: [id])

  enderecos Endereco[]

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@map("bairro")
}

model Sexo {
  id              Int      @id @default(autoincrement()) @map("id_sexo")
  nome            String   @map("nome_sexo") @db.VarChar(100)
  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  consumidores Consumidor[]

  @@map("sexo")
}

enum StatusLojista {
  PENDENTE
  APROVADO
  REJEITADO

  @@map("StatusLojista")
}

model Associacao {
  id                 Int     @id @default(autoincrement()) @map("id_associacao")
  nomeFantasia       String  @map("nome_fantasia_associacao") @db.VarChar(255)
  razaoSocial        String  @map("razao_social_associacao") @db.VarChar(255)
  cnpj               String  @unique @map("cnpj_associacao") @db.VarChar(18)
  inscricaoEstadual  Int?    @map("inscricao_estadual_associacao")

  usuarioId Int     @unique @map("id_usuario")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  lojistas  Lojista[]
  campanhas Campanha[]

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@map("associacao")
}

model Lojista {
  id                Int           @id @default(autoincrement()) @map("id_lojista")
  nomeFantasia      String        @map("nome_fantasia_lojista") @db.VarChar(255)
  razaoSocial       String        @map("razao_social_lojista") @db.VarChar(255)
  cnpj              String        @unique @map("cnpj_lojista") @db.VarChar(18)
  inscricaoEstadual Int?          @map("inscricao_estadual_lojista")
  status            StatusLojista @default(PENDENTE) @map("status")

  usuarioId Int     @unique @map("id_usuario")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  associacaoId Int        @map("id_associacao")
  associacao   Associacao @relation(fields: [associacaoId], references: [id])

  consumidores Consumidor[]
  produtos     Produto[]
  eventos      Evento[]
  missoes      Missao[]

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@index([associacaoId])
  @@index([status])
  @@map("lojista")
}

model Consumidor {
  id     Int @id @default(autoincrement()) @map("id_consumidor")
  cpf    String @unique @map("cpf_consumidor") @db.VarChar(14)
  pontos Int    @default(0) @map("pontos_consumidor")
  nivel  Int    @default(1) @map("nivel_consumidor")

  sexoId Int?   @map("id_sexo")
  sexo   Sexo?  @relation(fields: [sexoId], references: [id])

  lojistaId Int?     @map("id_lojista")
  lojista   Lojista? @relation(fields: [lojistaId], references: [id])

  usuarioId Int     @unique @map("id_usuario")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  missaoConsumidores MissaoConsumidor[]

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@index([sexoId])
  @@index([lojistaId])
  @@map("consumidor")
}

model Produto {
  id     Int     @id @default(autoincrement()) @map("id_produto")
  nome   String  @map("nome_produto") @db.VarChar(255)
  valor  Decimal @map("valor_produto") @db.Decimal(10, 2)

  /// Sem FK no SQL (`categoria_fk`) — Integer opcional até existir tabela Categoria
  categoriaId Int? @map("categoria_fk")

  lojistaId Int     @map("id_lojista")
  lojista   Lojista @relation(fields: [lojistaId], references: [id])

  promocoes Promocao[]

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@index([lojistaId])
  @@map("produto")
}

model Promocao {
  id        Int      @id @default(autoincrement()) @map("id_promocao")
  descricao String?  @map("descricao_promocao") @db.VarChar(500)
  preco     Decimal  @map("preco_promocao") @db.Decimal(10, 2)

  produtoId Int     @map("id_produto")
  produto   Produto @relation(fields: [produtoId], references: [id])

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@index([produtoId])
  @@map("promocao")
}

model Evento {
  id        Int     @id @default(autoincrement()) @map("id_evento")
  nome      String  @map("nome_evento") @db.VarChar(255)
  descricao String? @map("descricao_evento") @db.VarChar(500)

  lojistaId Int     @map("id_lojista")
  lojista   Lojista @relation(fields: [lojistaId], references: [id])

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@index([lojistaId])
  @@map("evento")
}

model Missao {
  id              Int     @id @default(autoincrement()) @map("id_missao")
  nome            String  @map("nome_missao") @db.VarChar(255)
  descricao       String? @map("descricao_missao") @db.VarChar(500)
  pontoRecompensa Int     @default(0) @map("ponto_recompensa_missao")

  lojistaId Int     @map("id_lojista")
  lojista   Lojista @relation(fields: [lojistaId], references: [id])

  missaoConsumidores MissaoConsumidor[]

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@index([lojistaId])
  @@map("missao")
}

/// N:M missão ↔ consumidor. Presença do registro = missão concluída (sem status extra).
/// UNIQUE (missaoId, consumidorId) impede farm de pontos.
model MissaoConsumidor {
  id Int @id @default(autoincrement()) @map("id_missao_consumidor")

  missaoId Int    @map("id_missao")
  missao   Missao @relation(fields: [missaoId], references: [id])

  consumidorId Int        @map("id_consumidor")
  consumidor   Consumidor @relation(fields: [consumidorId], references: [id])

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@unique([missaoId, consumidorId])
  @@index([missaoId])
  @@index([consumidorId])
  @@map("missao_consumidor")
}

model Campanha {
  id        Int     @id @default(autoincrement()) @map("id_campanha")
  nome      String  @map("nome_campanha") @db.VarChar(255)
  descricao String? @map("descricao_campanha") @db.VarChar(500)
  qrcode    String? @map("qrcode_campanha") @db.VarChar(500)

  associacaoId Int        @map("id_associacao")
  associacao   Associacao @relation(fields: [associacaoId], references: [id])

  sorteios Sorteio[]

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@index([associacaoId])
  @@map("campanha")
}

model Sorteio {
  id     Int     @id @default(autoincrement()) @map("id_sorteio")
  qrcode String? @map("qrcode_sorteio") @db.VarChar(500)

  campanhaId Int      @map("id_campanha")
  campanha   Campanha @relation(fields: [campanhaId], references: [id])

  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@index([campanhaId])
  @@map("sorteio")
}
